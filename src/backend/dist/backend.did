type http_request_result = 
 record {
   body: blob;
   headers: vec http_header;
   status: nat;
 };
type http_header = 
 record {
   name: text;
   value: text;
 };
type _ImmutableObjectStorageRefillResult = 
 record {
   success: opt bool;
   topped_up_amount: opt nat;
 };
type _ImmutableObjectStorageRefillInformation = record {
                                                  proposed_top_up_amount:
                                                   opt nat;};
type _ImmutableObjectStorageCreateCertificateResult = 
 record {
   blob_hash: text;
   method: text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type UserProfile = 
 record {
   createdAt: Timestamp;
   displayName: text;
   email: text;
   savedAddresses: vec SavedAddress;
 };
type UpdateProductInput = 
 record {
   categoryId: CategoryId;
   compareAtPrice: opt nat;
   description: text;
   id: ProductId;
   images: vec ExternalBlob;
   isFeatured: bool;
   isNewArrival: bool;
   name: text;
   priceInCents: nat;
   variants: vec ProductVariant;
 };
type TransformationOutput = 
 record {
   body: blob;
   headers: vec http_header;
   status: nat;
 };
type TransformationInput = 
 record {
   context: blob;
   response: http_request_result;
 };
type Timestamp = int;
type StripeSessionStatus = 
 variant {
   completed: record {
                response: text;
                userPrincipal: opt text;
              };
   failed: record {error: text;};
 };
type StripeConfiguration = 
 record {
   allowedCountries: vec text;
   secretKey: text;
 };
type ShoppingItem = 
 record {
   currency: text;
   priceInCents: nat;
   productDescription: text;
   productName: text;
   quantity: nat;
 };
type ShippingAddress = 
 record {
   city: text;
   country: text;
   fullName: text;
   postalCode: text;
   state: text;
   street: text;
 };
type SavedAddress = 
 record {
   addressLabel: text;
   city: text;
   country: text;
   fullName: text;
   postalCode: text;
   state: text;
   street: text;
 };
type ProductVariant = 
 record {
   color: text;
   size: text;
   stock: nat;
 };
type ProductId = nat;
type ProductFilter = 
 record {
   categoryId: opt CategoryId;
   color: opt text;
   inStockOnly: bool;
   maxPriceInCents: opt nat;
   minPriceInCents: opt nat;
   searchQuery: opt text;
   size: opt text;
 };
type Product = 
 record {
   categoryId: CategoryId;
   compareAtPrice: opt nat;
   createdAt: Timestamp;
   description: text;
   id: ProductId;
   images: vec ExternalBlob;
   isFeatured: bool;
   isNewArrival: bool;
   name: text;
   priceInCents: nat;
   variants: vec ProductVariant;
 };
type OrderStatus = 
 variant {
   cancelled;
   delivered;
   paid;
   pending;
   processing;
   shipped;
 };
type OrderItem = 
 record {
   color: text;
   priceInCents: nat;
   productId: ProductId;
   productName: text;
   quantity: nat;
   size: text;
 };
type OrderId = nat;
type Order = 
 record {
   buyer: principal;
   createdAt: Timestamp;
   id: OrderId;
   items: vec OrderItem;
   shippingAddress: ShippingAddress;
   shippingInCents: nat;
   status: OrderStatus;
   stripeSessionId: opt text;
   subtotalInCents: nat;
   totalInCents: nat;
   updatedAt: Timestamp;
 };
type ExternalBlob = blob;
type CreateProductInput = 
 record {
   categoryId: CategoryId;
   compareAtPrice: opt nat;
   description: text;
   images: vec ExternalBlob;
   isFeatured: bool;
   isNewArrival: bool;
   name: text;
   priceInCents: nat;
   variants: vec ProductVariant;
 };
type CreateOrderInput = 
 record {
   shippingAddress: ShippingAddress;
   stripeSessionId: opt text;
 };
type CategoryId = nat;
type Category = 
 record {
   createdAt: Timestamp;
   description: text;
   id: CategoryId;
   name: text;
   parentId: opt CategoryId;
   slug: text;
 };
type CartItemId = nat;
type CartItem = 
 record {
   color: text;
   id: CartItemId;
   priceInCents: nat;
   productId: ProductId;
   quantity: nat;
   size: text;
 };
type Cart = 
 record {
   items: vec CartItem;
   totalInCents: nat;
 };
service : {
  _immutableObjectStorageBlobsAreLive: (hashes: vec blob) -> (vec bool) query;
  _immutableObjectStorageBlobsToDelete: () -> (vec blob) query;
  _immutableObjectStorageConfirmBlobDeletion: (blobs: vec blob) -> ();
  _immutableObjectStorageCreateCertificate: (blobHash: text) ->
   (_ImmutableObjectStorageCreateCertificateResult);
  _immutableObjectStorageRefillCashier: (refillInformation:
   opt _ImmutableObjectStorageRefillInformation) ->
   (_ImmutableObjectStorageRefillResult);
  _immutableObjectStorageUpdateGatewayPrincipals: () -> ();
  _initializeAccessControl: () -> ();
  addSavedAddress: (address: SavedAddress) -> (bool);
  addToCart: (productId: ProductId, size: text, color: text, quantity:
   nat) -> (CartItemId);
  addToWishlist: (productId: ProductId) -> ();
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  clearCart: () -> ();
  createCategory: (name: text, slug: text, description: text, parentId:
   opt CategoryId) -> (Category);
  createCheckoutSession: (items: vec ShoppingItem, successUrl: text,
   cancelUrl: text) -> (text);
  createOrder: (input: CreateOrderInput) -> (Order);
  createProduct: (input: CreateProductInput) -> (Product);
  deleteCategory: (id: CategoryId) -> (bool);
  deleteProduct: (id: ProductId) -> (bool);
  getAllOrders: () -> (vec Order) query;
  getCallerUserProfile: () -> (opt UserProfile) query;
  getCallerUserRole: () -> (UserRole) query;
  getCart: () -> (Cart) query;
  getCategories: () -> (vec Category) query;
  getFeaturedProducts: () -> (vec Product) query;
  getMyOrders: () -> (vec Order) query;
  getNewArrivals: () -> (vec Product) query;
  getOrder: (id: OrderId) -> (opt Order) query;
  getProduct: (id: ProductId) -> (opt Product) query;
  getStripeSessionStatus: (sessionId: text) -> (StripeSessionStatus);
  getUserProfile: (user: principal) -> (opt UserProfile) query;
  getWishlist: () -> (vec ProductId) query;
  isCallerAdmin: () -> (bool) query;
  isStripeConfigured: () -> (bool) query;
  removeFromCart: (itemId: CartItemId) -> (bool);
  removeFromWishlist: (productId: ProductId) -> ();
  removeSavedAddress: (addressLabel: text) -> (bool);
  saveCallerUserProfile: (profile: UserProfile) -> ();
  searchProducts: (filter: ProductFilter) -> (vec Product) query;
  setStripeConfiguration: (config: StripeConfiguration) -> ();
  transform: (input: TransformationInput) -> (TransformationOutput) query;
  updateCartItem: (itemId: CartItemId, quantity: nat) -> (bool);
  updateCategory: (id: CategoryId, name: text, slug: text, description: 
   text, parentId: opt CategoryId) -> (bool);
  updateOrderStatus: (id: OrderId, status: OrderStatus) -> (bool);
  updateOrderStripeSession: (id: OrderId, sessionId: text) -> (bool);
  updateProduct: (input: UpdateProductInput) -> (bool);
}
